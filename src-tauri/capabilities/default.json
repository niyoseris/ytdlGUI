{
  "identifier": "default",
  "description": "Default capabilities for ytGUI",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOWNLOAD/*" },
        { "path": "$HOME/Downloads/*" },
        { "path": "$APPDATA/*" },
        { "path": "$HOME/Documents/*" },
        { "path": "$DESKTOP/*" }
      ]
    }
  ]
}
